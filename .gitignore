# Virtual environments
.venv/
venv/
env/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Scraping artifacts: they are data, not code.
# The scraped content belongs to third parties (Instagram) and the runs are
# reproducible with the scripts, so versioning them only adds noise and bulk.
output/
downloads/
# Local test runs (third-party images, ~20 MB per batch).
# `output/` and `downloads/` are root-owned and cannot be written to without
# sudo, so local runs go to `data/`.
data/
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm

# Persistent Chrome profile from the CAPTCHA bootstrap.
# It may contain session cookies: it must never be committed.
.ig_google_profile/

# Secrets and local configuration
.env
.env.*
*.pem
*.key

# Sistema
.DS_Store
Thumbs.db